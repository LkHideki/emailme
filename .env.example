# Copie para `.env` e preencha. O arquivo `.env` nunca deve ser commitado.

# Obrigatório: senha de app do Gmail (https://myaccount.google.com/apppasswords)
EMAILME_PASSWORD=sua_senha_de_app
# (compatibilidade) o nome antigo também é aceito:
# SENHA_DE_APP_GMAIL=sua_senha_de_app

# Opcional: remetente padrão da CLI
EMAILME_USERNAME=seu_email@gmail.com

# Opcionais: servidor SMTP (padrões para o Gmail)
# EMAILME_SMTP_HOST=smtp.gmail.com
# EMAILME_SMTP_PORT=587
# EMAILME_STARTTLS=true
# EMAILME_TIMEOUT=30
